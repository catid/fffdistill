This file records the exact vendor patches applied by `scripts/apply_vendor_patches.py`.

Upstream dependency versions:
- mamba-ssm 2.3.2.post1 from state-spaces/mamba commit ed6ce09e4d802e274b1ecc7205757b892e180a93.
- apache-tvm-ffi 0.1.12.
- tilelang 0.1.8.

These patches do not replace Mamba-3, do not disable TileLang MIMO training kernels, and
do not fall back to Mamba-2 or a fake block. They repair Python 3.12 import/lowering
compatibility while preserving the official optimized TileLang MIMO path.

diff --git a/tvm_ffi/registry.py b/tvm_ffi/registry.py
--- a/tvm_ffi/registry.py
+++ b/tvm_ffi/registry.py
@@ -396,10 +396,16 @@ def register_object(type_key: str = None):
     return decorator


+_UNSETTABLE_TYPE_DUNDERS = frozenset({"__dict__", "__weakref__"})
+
+
 def _add_class_attrs(type_cls: type, type_info: TypeInfo) -> type:
     for field in type_info.fields:
         name = field.name
+        if name in _UNSETTABLE_TYPE_DUNDERS:
+            continue
         if name not in type_cls.__dict__:  # skip attributes defined directly on this class
             setattr(type_cls, name, field.as_property(type_cls))


